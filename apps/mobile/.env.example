# Leave blank during local Expo Go testing to derive the API host from Metro.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_OFFLINE_DEV=1
# Web + native Leaflet map tile provider. The OSM default is for development only.
EXPO_PUBLIC_MAP_TILE_URL=
EXPO_PUBLIC_MAP_ATTRIBUTION=
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
